<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text color="#333333" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f5f5f5">
    <!-- Main Container -->
    <mj-section background-color="#ffffff" padding="50px 40px">
      <mj-column>
        <!-- Main Heading -->
        <mj-text 
          font-size="36px" 
          font-weight="bold" 
          color="#1a1a1a"
          padding-bottom="30px"
        >
          Reset Your Password
        </mj-text>
        
        <!-- Greeting -->
        <mj-text 
          font-size="18px" 
          color="#6b7280"
          padding-bottom="25px"
        >
          Hi <%= name %>,
        </mj-text>
        
        <!-- Main Message -->
        <mj-text 
          font-size="16px" 
          color="#6b7280"
          padding-bottom="25px"
        >
          We received a request to reset the password for your account. No changes have been made to your account yet.
        </mj-text>
        
        <!-- Instruction Text -->
        <mj-text 
          font-size="16px" 
          color="#6b7280"
          padding-bottom="30px"
        >
          You can reset your password by clicking the button below:
        </mj-text>
        
        <!-- Reset Password Button -->
        <mj-button 
          background-color="#3b82f6" 
          color="#ffffff"
          font-size="18px"
          font-weight="600"
          border-radius="6px"
          padding-bottom="35px"
          href="<%= link %>"
          inner-padding="16px 40px"
        >
          Reset Password
        </mj-button>
        
        <!-- Security Notice -->
        <mj-text 
          font-size="16px" 
          color="#6b7280"
          padding-bottom="25px"
        >
          If you did not request a password reset, please ignore this email or contact support if you have questions.
        </mj-text>
        
        <!-- Expiration Notice -->
        <mj-text 
          font-size="16px" 
          color="#6b7280"
          padding-bottom="35px"
        >
          The password reset link will expire in 24 hours.
        </mj-text>
        
        <!-- Alternative Link Section -->
        <mj-text 
          font-size="16px" 
          color="#6b7280"
          padding-bottom="15px"
        >
          If the button above doesn't work, copy and paste the following link into your browser:
        </mj-text>
        
        <!-- Reset Link URL -->
        <mj-text 
          font-size="14px" 
          color="#3b82f6"
          padding-bottom="0"
        >
          <a href="<%= link %>" style="color: #3b82f6; word-break: break-all;"><%= link %></a>
        </mj-text>
        
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>