<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter Your Register Email</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    <style>
        .card {
            width: 450px;
            background: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.1);
        }

        .alert {
            padding: 12px 15px;
            background: #fff3cd;
            border-left: 4px solid #ffc107;
            margin-bottom: 20px;
            border-radius: 6px;
            font-size: 14px;
            color: #8a6d3b;
        }

        h2 {
            margin: 10px 0 5px;
            font-size: 22px;
            font-weight: 600;
            color: #222;
        }

        .underline {
            width: 60px;
            height: 3px;
            background: #3b82f6;
            margin-bottom: 25px;
        }

        .input-box {
            position: relative;
            margin-bottom: 25px;
        }

        .input-box input {
            width: 80%;
            padding: 12px 40px;
            border: 1.5px solid #ddd;
            border-radius: 6px;
            font-size: 15px;
            outline: none;
        }

        .input-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #777;
        }

        button {
            width: 100%;
            background: #1a73e8;
            color: white;
            padding: 12px;
            font-size: 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        button:hover {
            background: #0d5ed9;
        }

        .error-message {
            color: red;
            font-size: 14px;
            margin-bottom: 8px;
        }

        p {
            font-size: 16px;
            color: #333;
            line-height: 1.5;
        }
    </style>

</head>

<body>

    <%- include("../partials/header") %>


        <div class="card">

            <% if (!user) { %>
                <div class="alert">
                    <i class="fa-solid fa-circle-exclamation"></i> &nbsp;
                    You are not logged in
                </div>
                <% } %>

                    <% if(formSubmitted){ %>

                        <p>
                            If the email that you have given us is correct, we have sent an email
                            to reset password to your email.
                        </p>

                        <% } else { %>

                            <h2>Enter Your Register Email</h2>
                            <div class="underline"></div>

                            <form action="/reset-password" method="POST">

                                <div class="input-box">
                                    <i class="fa-solid fa-envelope"></i>
                                    <input type="email" name="email" placeholder="Enter your Register Email">
                                </div>

                                <% if (errors && errors.length> 0) { %>
                                    <% errors.forEach((error)=> { %>
                                        <div class="error-message">
                                            <%= error %>
                                        </div>
                                        <% }) %>
                                            <% } %>

                                                <button type="submit">Submit</button>

                            </form>

                            <% } %>

        </div>
        <%- include("../partials/footer") %>

</body>

</html>