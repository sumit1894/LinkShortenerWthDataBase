<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>URL Shortener</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>

<body>
  <%- include("./partials/header") %>

    <div class="status-badge">
      <i class="fas fa-check-circle"></i>
      <% if (user) { %>
        <span>You are Logged In</span>
        <% } else { %>
          <span>You are Logged Out</span>
          <% } %>
    </div>

    <section class="hero">
      <div class="container">
        <h1>URL Shortener</h1>

        <form action="/" method="post" class="url-form">
          <div class="form-group">
            <label for="url">Enter URL:</label>
            <input name="url" id="url" required>
          </div>
          <div class="form-group">
            <label for="shortCode">Enter Short Code:</label>
            <input name="shortCode" id="shortCode">
          </div>
          <% if (errors && errors.length> 0) { %>
            <% errors.forEach((error)=> { %>
              <p style="color:red;">
                <%= error %>
              </p>
              <% }) %>
                <% } %>
                  <button type="submit">Shorten</button>
        </form>

        <h2>Shortened URLs</h2>

        <ul class="url-list">
          <% links.map(({url, shortCode,id})=> { %>
            <% const truncatedURL=url.length>= 30 ? `${url.slice(0,30)}...` : url %>

              <li>
                <div class="url-info">
                  <a href="/<%= shortCode %>" target="_blank">
                    <%= hosts %>/<%= shortCode %>
                  </a>
                  - <%= truncatedURL %>
                </div>

                <div class="url-action">

                  <button class="copy-btn" data-url="<%=hosts%>/<%=shortCode%>">
                    <i class="fa-solid fa-copy"></i>
                  </button>

                  <button class="copy-btn edit-btn">
                    <a href="/edit/<%=id%>">
                      <i class="fa-solid fa-edit"></i>
                    </a>
                  </button>

                  <form action="/delete/<%= id %>" method="post">
                    <button class="copy-btn edit-btn">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>

                </div>
              </li>
              <% }) %>
        </ul>

      </div>


    </section>

<div class="pagination">

  <!-- Prev Button -->
  <a 
    href="?page=<%= currentPage - 1 %>" 
    class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>"
  >
    Prev
  </a>

  <% 
    let startPage = Math.max(1, currentPage - 2);
    let endPage = Math.min(totalPages, currentPage + 2);
  %>

  <!-- If start page > 1, show first page -->
  <% if (startPage > 1) { %>
    <a href="?page=1" class="page-num">1</a>

    <% if (startPage > 2) { %>
      <span class="dots">...</span>
    <% } %>
  <% } %>

  <!-- Loop through page numbers -->
  <% for (let i = startPage; i <= endPage; i++) { %>
    <% if (i === currentPage) { %>
      <span class="page-num active"><%= i %></span>
    <% } else { %>
      <a href="?page=<%= i %>" class="page-num"><%= i %></a>
    <% } %>
  <% } %>

  <!-- If endPage < last page -->
  <% if (endPage < totalPages) { %>

    <% if (endPage < totalPages - 1) { %>
      <span class="dots">...</span>
    <% } %>

    <a href="?page=<%= totalPages %>" class="page-num"><%= totalPages %></a>
  <% } %>

  <!-- Next Button -->
  <a 
    href="?page=<%= currentPage + 1 %>" 
    class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>"
  >
    Next
  </a>

</div>






    <%- include("./partials/footer") %>
</body>

</html>

